tm.add_student('S103', 'Charlie Brown', 'Grade 6', fees_due=150.0)
tm.add_student('S104', 'Diana Prince', 'Grade 8', fees_due=120.0)
tm.add_student('S105', 'Clark Kent', 'Grade 5', fees_due=150.0)

# 4. Assign students to buses
tm.assign_student_to_bus('S101', 'B001')
tm.assign_student_to_bus('S102', 'B001')
tm.assign_student_to_bus('S103', 'B002')
tm.assign_student_to_bus('S104', 'B001')
tm.assign_student_to_bus('S105', 'B002')

# 5. View Buses
tm.view_buses()

# 6. View Routes
tm.view_routes()

# 7. View Students
