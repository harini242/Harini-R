class TransportManager:
    def __init__(self):
        self.buses = {}
        self.routes = {}
        self.students = {}

    def add_bus(self, bus_id, capacity):
        if bus_id not in self.buses:
            self.buses[bus_id] = Bus(bus_id, capacity)
            print(f"Bus {bus_id} added.")
        else:
            print(f"Bus {bus_id} already exists.")

    def add_route(self, route_id, name, stops):
        if route_id not in self.routes:
            self.routes[route_id] = Route(route_id, name, stops)
            print(f"Route {route_id} added.")
        else:
            print(f"Route {route_id} already exists.")

    def add_student(self, student_id, name, grade, fees_due=0.0):
        if student_id not in self.students:
            self.students[student_id] = Student(student_id, name, grade, fees_due)
            print(f"Student {student_id} added.")
        else:
            print(f"Student {student_id} already exists.")

    def assign_student_to_bus(self, student_id, bus_id):
        if student_id in self.students and bus_id in self.buses:
            student = self.students[student_id]
            bus = self.buses[bus_id]

            # If student was previously assigned to another bus, remove them first
            if student.assigned_bus_id and student.assigned_bus_id != bus_id:
                prev_bus = self.buses[student.assigned_bus_id]
                prev_bus.remove_student(student_id)

            if bus.assign_student(student_id):
                student.assign_bus(bus_id)
                print(f"Student {student_id} successfully assigned to bus {bus_id}.")
            else:
                print(f"Could not assign student {student_id} to bus {bus_id} due to capacity.")
        else:
            print("Invalid student ID or bus ID.")

    def view_buses(self):
        if not self.buses:
            print("No buses registered.")
            return
        print("\n--- All Buses ---")
        for bus_id, bus in self.buses.items():
            print(bus)

    def view_routes(self):
        if not self.routes:
            print("No routes registered.")
            return
        print("\n--- All Routes ---")
        for route_id, route in self.routes.items():
            print(route)
            if route.assigned_buses:
                print(f"  Assigned Buses: {', '.join(route.assigned_buses)}")
            else:
                print("  No buses assigned.")

    def view_students(self):
        if not self.students:
            print("No students registered.")
            return
        print("\n--- All Students ---")
        for student_id, student in self.students.items():
            print(student)

    def track_bus_capacity(self, bus_id):
        if bus_id in self.buses:
            bus = self.buses[bus_id]
            print(f"\nBus {bus_id} - Occupancy: {bus.get_occupancy()}/{bus.capacity}, Remaining Capacity: {bus.get_remaining_capacity()}")
        else:
            print(f"Bus {bus_id} not found.")

    def manage_fees(self, student_id, amount, action='pay'):
        if student_id in self.students:
            student = self.students[student_id]
            if action == 'pay':
                student.pay_fees(amount)
            elif action == 'set_due':
                student.fees_due = amount
                print(f"Fees due for {student.name} set to {amount}.")
            else:
                print("Invalid fee action. Use 'pay' or 'set_due'.")
        else:
            print(f"Student {student_id} not found.")
