class Bus:
    def __init__(self, bus_id, capacity):
        self.bus_id = bus_id
        self.capacity = capacity
        self.students_assigned = []

    def assign_student(self, student_id):
        if len(self.students_assigned) < self.capacity:
            self.students_assigned.append(student_id)
            print(f"Student {student_id} assigned to Bus {self.bus_id}.")
            return True
        else:
            print(f"Bus {self.bus_id} is at full capacity.")
            return False

    def remove_student(self, student_id):
        if student_id in self.students_assigned:
            self.students_assigned.remove(student_id)
            print(f"Student {student_id} removed from Bus {self.bus_id}.")
            return True
        else:
            print(f"Student {student_id} not found on Bus {self.bus_id}.")
            return False

    def get_occupancy(self):
        return len(self.students_assigned)

    def get_remaining_capacity(self):
        return self.capacity - len(self.students_assigned)

    def __str__(self):
        return f"Bus ID: {self.bus_id}, Capacity: {self.capacity}, Occupancy: {self.get_occupancy()}, Remaining: {self.get_remaining_capacity()}"

class Route:
    def __init__(self, route_id, name, stops):
        self.route_id = route_id
        self.name = name
        self.stops = stops # List of stop names/locations
        self.assigned_buses = []

    def assign_bus(self, bus_id):
        if bus_id not in self.assigned_buses:
            self.assigned_buses.append(bus_id)
            print(f"Bus {bus_id} assigned to Route {self.route_id}.")
        else:
            print(f"Bus {bus_id} is already assigned to Route {self.route_id}.")

    def __str__(self):
        return f"Route ID: {self.route_id}, Name: {self.name}, Stops: {', '.join(self.stops)}"

class Student:
    def __init__(self, student_id, name, grade, fees_due=0.0):
        self.student_id = student_id
        self.name = name
        self.grade = grade
        self.assigned_bus_id = None
        self.fees_due = fees_due
        self.fees_paid = 0.0

    def assign_bus(self, bus_id):
        self.assigned_bus_id = bus_id

    def pay_fees(self, amount):
        if amount > 0:
            self.fees_paid += amount
            self.fees_due = max(0, self.fees_due - amount)
            print(f"Fees paid for {self.name}: {amount}. Remaining due: {self.fees_due}.")
        else:
            print("Payment amount must be positive.")

    def __str__(self):
        return f"Student ID: {self.student_id}, Name: {self.name}, Bus: {self.assigned_bus_id or 'N/A'}, Fees Due: {self.fees_due}"
Transport Manager Class
This class will act as the central hub to manage all buses, routes, and student assignments.


